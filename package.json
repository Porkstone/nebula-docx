{
  "name": "nebula-docx",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "test": "node scripts/smoke-test.mjs && node scripts/editor-test.mjs && node scripts/theme-test.mjs",
    "fixtures": "node scripts/create-fixtures.mjs",
    "dist:win": "pnpm build && electron-builder --win --x64 --publish never",
    "notices": "node scripts/notices.mjs",
    "test:editor": "node scripts/editor-test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "docx": "^9.12.0",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "description": "An offline Windows DOCX viewer and editor with printing and Markdown export.",
  "author": "Porkstone",
  "license": "MIT",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/Porkstone/nebula-docx",
  "repository": {
    "type": "git",
    "url": "https://github.com/Porkstone/nebula-docx.git"
  },
  "packageManager": "pnpm@11.15.1"
}
