    <id>nebula-docx</id>
    <version>1.0.0</version>
    <title>Nebula DOCX</title>
    <authors>Porkstone</authors>
    <owners>Porkstone</owners>
    <projectUrl>https://github.com/Porkstone/nebula-docx</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/Porkstone/nebula-docx/v1.0.0/build/icon.png</iconUrl>
    <packageSourceUrl>https://github.com/Porkstone/nebula-docx/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://github.com/Porkstone/nebula-docx#readme</docsUrl>
    <bugTrackerUrl>https://github.com/Porkstone/nebula-docx/issues</bugTrackerUrl>
